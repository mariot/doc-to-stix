# Copy to .env, then run ./make-secrets.sh to replace every "changeme".
OPENCTI_PORT=8088
OPENCTI_ADMIN_EMAIL=admin@opencti.local
OPENCTI_ADMIN_PASSWORD=changeme
OPENCTI_ADMIN_TOKEN=changeme
OPENCTI_ENCRYPTION_KEY=changeme
OPENCTI_HEALTHCHECK_ACCESS_KEY=changeme
MINIO_ROOT_USER=opencti
MINIO_ROOT_PASSWORD=changeme
RABBITMQ_DEFAULT_USER=opencti
RABBITMQ_DEFAULT_PASS=changeme
# Elasticsearch heap. The colima VM has 12 GB; 2G is enough for a few thousand reports.
ELASTIC_MEMORY_SIZE=2G
# Fixed connector IDs (UUIDv4), so a restart reuses the same connectors.
CONNECTOR_OPENCTI_ID=dd010812-9027-4726-bf7b-4936979955ae
CONNECTOR_MITRE_ID=8307ea1e-9356-408c-a510-2d7f8b28a0e2
CONNECTOR_IMPORT_DOCUMENT_ID=c3970f8a-ce4b-4497-a381-20b7256f56f0
